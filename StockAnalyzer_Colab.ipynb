    "# ③ 앱 소스 다운로드\n",
    "import urllib.request\n",
    "\n",
    "# GitHub raw URL (자신의 repo URL로 변경)\n",
    "REPO_RAW = 'https://raw.githubusercontent.com/hoonyoung/ClaudeTest/claude%2Fstock-market-analyzer-DKjiW'\n",
