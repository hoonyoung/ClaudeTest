   "source": [
    "# ④ 앱 실행\n",
    "# colab_app.py 다운로드가 성공한 경우:\n",
    "import importlib.util, sys\n",
    "\n",
    "spec = importlib.util.spec_from_file_location('colab_app', 'colab_app.py')\n",
    "mod = importlib.util.module_from_spec(spec)\n",
    "spec.loader.exec_module(mod)\n",
    "\n",
    "app = mod.create_app()\n",
    "app.launch(\n",
    "    share=True,        # ← 공개 URL 생성 (colab.research.google.com에서 필요)\n",
    "    server_port=7860,\n",
    "    show_error=True,\n",
    "    quiet=False,\n",
    ")"
   ]
