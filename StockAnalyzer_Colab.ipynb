    "# 주가 차트만 보기\n",
    "from colab_app import resolve_symbol, make_chart\n",
    "from IPython.display import Image, display\n",
    "import base64\n",
    "\n",
    "query = '삼성전자'  # ← 변경 가능\n",
    "period = '3mo'    # 1mo / 3mo / 6mo / 1y / 2y\n",
    "\n",
    "symbol, name, market = resolve_symbol(query)\n",
    "print(f'종목: {name} ({symbol}) [{market}]')\n",
    "\n",
    "img_b64, err = make_chart(symbol, name, market, period)\n",
    "if img_b64:\n",
    "    header, data = img_b64.split(',', 1)\n",
    "    display(Image(data=base64.b64decode(data)))\n",
    "else:\n",
    "    print('오류:', err)"
   ]
